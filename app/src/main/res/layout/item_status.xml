<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivStatusThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/status_saver_title"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivVideoBadge"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_play_circle"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSaveStatus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_dark"
            android:contentDescription="@string/save_to_gallery"
            android:src="@drawable/ic_download"
            app:tint="@color/yufi_cyan" />
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
